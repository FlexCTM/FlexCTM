&region ! 区域设置
   ndom = 1
   nlev = 29
   we                = 88, 93
   sn                = 77, 75
   parent_id         = 1, 1
   parent_grid_ratio = 1, 3
   i_parent_start    = 1, 29
   j_parent_start    = 1, 20
/

&proj
   proj_id = 1 ! 1 for LCC, 0 for latitude-longitude
   ref_lat = 28.5
   ref_lon = 114.0
   truelat1 = 15.0
   truelat2 = 40.0
   delta = 81000
/

&time
   start_time = '2024050812'
   run_hours = 24, 24
   dt = 300
/

&physics
   twindow = 1
   nhalo = 3
/

&chem
   chem_meta_file = './meta/species.csv'

   ic_file = './icbc/naqp_ic_d0[DOMAIN].nc'

   bc_file = './icbc/naqp_bc.nc'

   emis_file = '/3clear/share/xiaolh/v3/region/emis/diag_naqp_ar_total_d0[DOMAIN]_%Y%m%d%H.nc'
   emis_nlev = 20
/

&mete
   mete_table_file = './meta/mete.standard.csv'
   mete_mapping_file = './meta/mete.wrf.csv'
   mete_source = 'wrf'
   mete_file = '/3clear/share/xiaolh/v3/region/wrf/wrfout_d0[DOMAIN]_%Y-%m-%d_%H:00:00'
   mete_timedelta = 3600
/

&output
   out_file_name = 'ctm_d0[DOMAIN]_%Y%m%d%H.nc'
   static_grid_file = 'static_meta_d0[DOMAIN].nc'
/
