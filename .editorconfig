root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{f90,F90,f95,F95,f03,F03,f08,F08}]
indent_style = space
indent_size = 3
tab_width = 3
max_line_length = 120

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[{*.toml,*.yml,*.yaml,*.json}]
indent_style = space
indent_size = 2

[*.{md,py,sh,m4}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
tab_width = 4
